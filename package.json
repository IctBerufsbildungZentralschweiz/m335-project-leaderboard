{
  "name": "leaderboard",
  "version": "1.0.0",
  "description": "M335 Schnitzeljagd Leaderboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "DATABASE_PATH=./data/leaderboard.db tsx watch --env-file .env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "DATABASE_PATH=./data/leaderboard.db tsx --env-file .env src/cli/seed.ts",
    "test-seed": "DATABASE_PATH=./data/leaderboard.db tsx --env-file .env src/cli/test-seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
